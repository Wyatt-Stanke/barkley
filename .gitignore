# Everything generated by src/. All of it is reproducible — see CLAUDE.md "Commands".
#   build/outputs/  migrations and their LTS imports
#   build/fuzz/     the fuzzer's build, corpus and saved findings
#   build/deploy/   the deploy repo's working clone
build/

# Third-party installers (~320 MB).
tools/

# Game material: the pristine GMX export, the original distribution and the
# other releases. Large, immutable inputs — deliberately untracked.
# The recovered scripts are patch source, so they stay.
game/*
!game/recovered-scripts/

# The VM's own state and its cache of pinned third-party downloads. The machine
# is reproducible from virt/ -- see virt/README.md.
virt/.vagrant/
virt/cache/

.DS_Store
