diff -ruN a/scripts/sVolume.gml b/scripts/sVolume.gml
--- a/scripts/sVolume.gml	1969-12-31 19:00:00
+++ b/scripts/sVolume.gml	2026-09-17 19:42:22
@@ -0,0 +1,7 @@
+//Modernized: the gain for VOLUME step argument0 (0-10), for audio_master_gain.
+//The steps are equal in decibels, not in amplitude, because loudness is heard roughly logarithmically: with a linear
+//gain the top half of the slider hardly changes anything and the bottom half drops away all at once. Here every step
+//is 4 dB, so 50% is -20 dB (a tenth of the amplitude) and each step sounds about as big as the one before it.
+//Step 0 is silence rather than -40 dB, so the slider really can turn the sound off.
+if (argument0<=0) return 0;
+return power(10,(argument0-10)*0.2);
