diff -ruN a/objects/oController/3_1.gml b/objects/oController/3_1.gml
--- a/objects/oController/3_1.gml
+++ b/objects/oController/3_1.gml
@@ -1,3 +1,4 @@
+key_release(); //modernized: see key_clear
 //Timer
 global.did_action=0; //tells game if press action since i clear it, sand toss
 if (global.displayc=1) { room_goto(RomConfig); exit; }
diff -ruN a/scripts/key_check.gml b/scripts/key_check.gml
--- a/scripts/key_check.gml
+++ b/scripts/key_check.gml
@@ -0,0 +1,8 @@
+//Modernized: keyboard_check, except that a key cleared with key_clear reads as up until it is released
+var i;
+if (argument0=vk_anykey) {
+for (i=8; i<256; i+=1) if (keyboard_check(i) && global.key_latch[i]=0) return 1;
+return 0;
+}
+if (argument0<0 || argument0>255) return keyboard_check(argument0);
+return (keyboard_check(argument0) && global.key_latch[argument0]=0);
diff -ruN a/scripts/key_clear.gml b/scripts/key_clear.gml
--- a/scripts/key_clear.gml
+++ b/scripts/key_clear.gml
@@ -0,0 +1,9 @@
+//Modernized: GM6's keyboard_clear hid a key until it was released; LTS clears it for one frame only, so a held key
+//fires again (a menu cursor moves several items per press). The transform keyLatch sends keyboard_clear here.
+//A latch starts at 2, meaning "set this step": keyboard_clear also zeroes this step's keyboard_check, so a
+//key_release later in the same step must not read that as the key having been let go. Only a held key is latched.
+var i;
+if (argument0=vk_anykey) {
+for (i=8; i<256; i+=1) if (keyboard_check(i)) global.key_latch[i]=2;
+} else if (argument0>=0 && argument0<256 && keyboard_check(argument0)) global.key_latch[argument0]=2;
+keyboard_clear(argument0);
diff -ruN a/scripts/key_release.gml b/scripts/key_release.gml
--- a/scripts/key_release.gml
+++ b/scripts/key_release.gml
@@ -0,0 +1,9 @@
+//Modernized: releases keys latched by key_clear once they are up; oController's Begin Step calls this every step.
+//A latch of 2 was set this step, so keyboard_check still reads key_clear's zero rather than the keyboard: age it
+//to 1 and leave it. From the next step the runtime has rebuilt the key state, so an up key really is up.
+var i;
+if (variable_global_exists('key_latch')=0) for (i=255; i>=0; i-=1) global.key_latch[i]=0;
+for (i=8; i<256; i+=1) {
+if (global.key_latch[i]=2) global.key_latch[i]=1;
+else if (global.key_latch[i]=1 && keyboard_check(i)=0) global.key_latch[i]=0;
+}
