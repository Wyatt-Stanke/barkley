+//Modernized: the whole game state as JSON, for resume_restore: globals, every instance (built-in and own variables),
+//the mp_grid paths, views, backgrounds and playing sounds
+var s, g, names, i, j, n, list, e, b, v, k;
+s=json_parse('{}');
+variable_struct_set(s,'build',GM_build_date);
+variable_struct_set(s,'room',room_get_name(room));
+variable_struct_set(s,'time',current_time);
+variable_struct_set(s,'roomspeed',room_speed);
+g=json_parse('{}');
+names=variable_instance_get_names(global);
+n=array_length(names);
+for (i=0; i<n; i+=1) {
+k=names[i];
+if (string_pos('resume_',k)=1 || k='path' || k='key_latch' || k='displayx' || k='displayy') continue; //this session's own
+k=variable_global_get(k);
+if (!is_real(k)) { if (is_undefined(k)) k='~u'; else k=resume_enc(k); }
+variable_struct_set(g,names[i],k);
+}
+variable_struct_set(s,'globals',g);
+list=array_create(0);
+with (all) {
+e=json_parse('{}');
+variable_struct_set(e,'object',object_get_name(object_index));
+variable_struct_set(e,'iid',real(id)); //not 'id', which compiles to the built-in
+if (object_index!=oScreenFill) { //its surface doesn't survive a reload; the new one is kept
+b=array_create(0);
+array_push(b,x,y,xprevious,yprevious,xstart,ystart,hspeed,vspeed,direction,friction,gravity,gravity_direction);
+array_push(b,resume_enc(sprite_index),image_index,image_speed,image_xscale,image_yscale,image_angle,image_alpha,image_blend);
+array_push(b,resume_enc(mask_index),visible,solid,persistent,depth);
+if (layer!=-1) array_push(b,layer_get_name(layer)); else array_push(b,'');
+array_push(b,alarm[0],alarm[1],alarm[2],alarm[3],alarm[4],alarm[5],alarm[6],alarm[7],alarm[8],alarm[9],alarm[10],alarm[11]);
+array_push(b,resume_enc(path_index),path_position,path_speed,path_endaction,path_scale,path_orientation);
+variable_struct_set(e,'builtin',b);
+v=json_parse('{}');
+names=variable_instance_get_names(id);
+n=array_length(names);
+for (j=0; j<n; j+=1) {
+k=variable_instance_get(id,names[j]);
+if (!is_real(k)) { if (is_undefined(k)) k='~u'; else k=resume_enc(k); }
+variable_struct_set(v,names[j],k);
+}
+variable_struct_set(e,'vars',v);
+}
+array_push(list,e);
+}
+variable_struct_set(s,'instances',list);
+list=array_create(0);
+for (j=0; j<10; j+=1) {
+b=array_create(0);
+array_push(b,path_get_closed(global.path[j]),path_get_kind(global.path[j]),path_get_precision(global.path[j]));
+n=path_get_number(global.path[j]);
+for (i=0; i<n; i+=1) array_push(b,path_get_point_x(global.path[j],i),path_get_point_y(global.path[j],i),path_get_point_speed(global.path[j],i));
+array_push(list,b);
+}
+variable_struct_set(s,'paths',list);
+b=array_create(0);
+for (j=0; j<8; j+=1) array_push(b,view_xview[j],view_yview[j],view_wview[j],view_hview[j],view_visible[j]);
+variable_struct_set(s,'views',b);
+b=array_create(0);
+for (j=0; j<8; j+=1) array_push(b,background_visible[j],background_htiled[j],background_vtiled[j],background_x[j],background_y[j]);
+variable_struct_set(s,'backgrounds',b);
+b=array_create(0);
+if (variable_global_exists('resume_sounds')) {
+names=variable_struct_get_names(global.resume_sounds);
+for (j=0; j<array_length(names); j+=1) {
+i=variable_struct_get(global.resume_sounds,names[j]);
+if (audio_is_playing(i)) array_push(b,names[j],audio_sound_get_track_position(i),audio_sound_get_loop(i));
+}
+}
+variable_struct_set(s,'sounds',b);
+k=instance_create_depth(0,0,0,oResumeMark); //the next instance id
+instance_destroy(k,false);
+variable_struct_set(s,'nextid',real(k)+1);
+return json_stringify(s);
--- a/scripts/resume_skip.gml
+++ b/scripts/resume_skip.gml
@@ -0,0 +1,7 @@
+//Modernized: 1 while resume_start rebuilds a reloaded game, so the event calling it exits: Create events and instance
+//creation code (argument0=0) until the state is restored, Room Start events (1) until the next step.
+//The first Room Start in the saved room restores the state.
+if (variable_global_exists('resume_phase')=0) return 0;
+if (global.resume_phase=1 && argument0=1 && room=global.resume_room) with (oController) resume_restore();
+if (global.resume_phase=3) return argument0=1;
+return global.resume_phase!=0;
--- a/scripts/resume_start.gml
+++ b/scripts/resume_start.gml
@@ -0,0 +1,14 @@
+//Modernized: resume after the tab reloads. Called at Game Start; if the page kept a game state (migrate/resume.js),
+//goes straight to its room and returns 1. The transform resumeGate makes that room's Create and Room Start events
+//exit, and resume_skip rebuilds the saved state there instead.
+var s;
+global.resume_phase=0;
+global.resume_count=-1;
+s=resume_take();
+if (s='') return 0;
+global.resume_data=json_parse(s);
+if (abs(variable_struct_get(global.resume_data,'build')-GM_build_date)>0.00001) return 0; //saved by another build
+global.resume_room=asset_get_index(variable_struct_get(global.resume_data,'room'));
+global.resume_phase=1;
+room_goto(global.resume_room);
+return 1;
--- a/scripts/resume_tick.gml
+++ b/scripts/resume_tick.gml
@@ -0,0 +1,10 @@
+//Modernized: oController's Begin Step. Every 30 steps (half a second) the game state goes to the page
+//(migrate/resume.js), which stores it when the tab is hidden or closed. The intro, title and menus aren't kept:
+//entering them forgets the state.
+if (global.resume_phase=3) global.resume_phase=0;
+if (room=RomInit || room=RomStarter || room=RomIntro0 || room=RomIntro1 || room=RomTitle || room=RomLoad || room=RomConfig) {
+if (global.resume_count!=-1) { resume_clear(); global.resume_count=-1; }
+exit;
+}
+global.resume_count+=1;
+if (global.resume_count mod 30=0) resume_put(resume_save());
