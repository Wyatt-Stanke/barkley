+//Modernized: a value as JSON data for resume_save, which passes numbers and undefined ('~u') through itself.
+//Handles (instances, objects, sounds, ...) become '~ref <type> <id or name>' strings (string() writes
+//'ref <type>(<id or name>)'); a string that starts with ~ gets another.
+var a, i, n, v;
+if (is_handle(argument0)) {
+v=string(argument0);
+if (string_char_at(v,string_length(v))=')') v=string_replace(string_delete(v,string_length(v),1),'(',' ');
+return '~'+v;
+}
+if (is_string(argument0)) { if (string_char_at(argument0,1)='~') return '~'+argument0; return argument0; }
+if (!is_array(argument0)) return argument0;
+n=array_length(argument0);
+a=array_create(n);
+for (i=0; i<n; i+=1) { v=argument0[i]; if (is_real(v)) a[i]=v; else if (is_undefined(v)) a[i]='~u'; else a[i]=resume_enc(v); }
+return a;
