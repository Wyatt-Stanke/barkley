diff -ruN a/scripts/sSaveData.gml b/scripts/sSaveData.gml
--- a/scripts/sSaveData.gml	1969-12-31 19:00:00
+++ b/scripts/sSaveData.gml	2026-09-17 16:17:02
@@ -0,0 +1,9 @@
+//Modernized: opens the browser save transfer (migrate/saves.js), so a player can carry their save slots between
+//browsers and devices. The runtime keeps each save file under a prefix of its own in browser storage; writing a probe
+//file and handing saves.js its name is how the page finds that prefix without knowing how the runtime builds it.
+prb='transfer.tmp';
+tfl=file_text_open_write(prb);
+file_text_write_string(tfl,'x');
+file_text_close(tfl);
+saves_open(prb);
+file_delete(prb);
