diff -ruN a/scripts/sTouchContext.gml b/scripts/sTouchContext.gml
--- a/scripts/sTouchContext.gml	1969-12-31 19:00:00
+++ b/scripts/sTouchContext.gml	2026-09-17 19:07:57
@@ -0,0 +1,8 @@
+//Modernized: what the player is doing, so the touch overlay can dim itself (migrate/touch.js)
+//0 overworld, 1 menu, 2 dialog, 3 cutscene, 4 rebinding keys
+if (instance_exists(key_makestuff)) { if (key_makestuff.doall!=-1) return 4; }
+if (global.cinema=1 || global.freeze=1) return 3;
+if (instance_exists(oDialog)) return 2;
+if (instance_exists(oStartmenu)) return 1;
+if (room=RomTitle || room=RomLoad || room=RomConfig || room=RomStarter || room=RomGameover || room=RomInter) return 1;
+return 0;
