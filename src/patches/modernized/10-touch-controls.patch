diff -ruN a/objects/oScreenFill/8_77.gml b/objects/oScreenFill/8_77.gml
--- a/objects/oScreenFill/8_77.gml	2026-09-17 19:07:57
+++ b/objects/oScreenFill/8_77.gml	2026-09-17 19:07:57
@@ -1,14 +1,17 @@
-var ww, wh, aw, ah, s, k;
+var ww, wh, aw, ah, s, k, vx, vy, vw, vh;
 ww=window_get_width();
 wh=window_get_height();
 aw=surface_get_width(application_surface);
 ah=surface_get_height(application_surface);
-s=min(ww/aw,wh/ah);
+//Modernized: with touch controls the picture gets part of the window and the rest holds the controls
+if (touch_active()) { vx=touch_view_x(); vy=touch_view_y(); vw=touch_view_w(); vh=touch_view_h(); }
+else { vx=0; vy=0; vw=ww; vh=wh; }
+s=min(vw/aw,vh/ah);
 draw_clear(c_black);
 gpu_set_texfilter(0);
 if (global.sat[0]=0 || s<1 || s=floor(s)) { //Integer: whole-number scale, so every game pixel is the same size
 if (s>=1) s=floor(s);
-draw_surface_ext(application_surface,floor((ww-aw*s)/2),floor((wh-ah*s)/2),s,s,0,c_white,1);
+draw_surface_ext(application_surface,vx+floor((vw-aw*s)/2),vy+floor((vh-ah*s)/2),s,s,0,c_white,1);
 } else { //Sharp fit: nearest-neighbour up to the next whole scale, then bilinear down to the exact fit
 k=ceil(s);
 if (!surface_exists(surf) || surface_get_width(surf)!=aw*k || surface_get_height(surf)!=ah*k) {
@@ -19,6 +22,6 @@
 draw_surface_ext(application_surface,0,0,k,k,0,c_white,1);
 surface_reset_target();
 gpu_set_texfilter(1);
-draw_surface_ext(surf,floor((ww-aw*s)/2),floor((wh-ah*s)/2),s/k,s/k,0,c_white,1);
+draw_surface_ext(surf,vx+floor((vw-aw*s)/2),vy+floor((vh-ah*s)/2),s/k,s/k,0,c_white,1);
 gpu_set_texfilter(0);
 }
