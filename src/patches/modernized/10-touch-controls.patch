diff -ruN a/objects/oScreenFill/3_1.gml b/objects/oScreenFill/3_1.gml
--- a/objects/oScreenFill/3_1.gml	2026-09-17 19:07:57
+++ b/objects/oScreenFill/3_1.gml	2026-09-17 19:07:57
@@ -1,4 +1,8 @@
-if (window_get_width()!=browser_width || window_get_height()!=browser_height) {
-window_set_size(browser_width,browser_height);
+var dw, dh, r;
+r=touch_dpr(); //Modernized: the runtime ignores devicePixelRatio, so the canvas gets real device pixels
