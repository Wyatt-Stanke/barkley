 image_speed=global.rd/2;
 x=160;
-draw_sprite_ext(sTitle0,0,115,135,1,1,0,c_white,image_alpha);
+//Modernized: sTitle0 holds four rows, so it is drawn without its bottom frame (rows 0-57) and a fifth row for
+//Controls is built under it from the sprite's own blank interior and frame. Rows 54-57 are the blank ones: row
+//53 still carries the tail of the Q in Quit Vidcon. The rows are 13 apart and their text starts 18 in.
+draw_sprite_part_ext(sTitle0,0,0,0,89,58,115,135,1,1,c_white,image_alpha);
+draw_sprite_part_ext(sTitle0,0,0,54,89,4,115,135+58,1,1,c_white,image_alpha);
+draw_sprite_part_ext(sTitle0,0,0,54,89,4,115,135+62,1,1,c_white,image_alpha);
