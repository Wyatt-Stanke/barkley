+draw_sprite_part_ext(sTitle0,0,0,54,89,1,115,135+70,1,1,c_white,image_alpha);
+draw_sprite_part_ext(sTitle0,0,0,58,89,3,115,135+71,1,1,c_white,image_alpha);
+//The sprite's labels are set in a heavier face than any font the game carries, so the word is built from the
+//sprite's own letters: C o n t r come from Configuration (row 2), l from Load Datafile (row 1) and s from New
