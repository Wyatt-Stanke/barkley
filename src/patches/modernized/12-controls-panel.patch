+draw_sprite_part_ext(sTitle0,0,31,30,5,12,115+31,135+56,1,1,c_white,image_alpha); //n
+draw_sprite_part_ext(sTitle0,0,66,30,3,12,115+37,135+56,1,1,c_white,image_alpha); //t
+draw_sprite_part_ext(sTitle0,0,56,30,3,12,115+41,135+56,1,1,c_white,image_alpha); //r
+draw_sprite_part_ext(sTitle0,0,25,30,5,12,115+45,135+56,1,1,c_white,image_alpha); //o
+draw_sprite_part_ext(sTitle0,0,75,17,2,12,115+51,135+56,1,1,c_white,image_alpha); //l
+draw_sprite_part_ext(sTitle0,0,41,4,5,12,115+54,135+56,1,1,c_white,image_alpha); //s
 draw_sprite_ext(sDialogBlip,image_index,115+5,135+(pos*13)+5,1,1,0,c_white,image_alpha);
