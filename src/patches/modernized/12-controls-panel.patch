diff -ruN a/scripts/sControls.gml b/scripts/sControls.gml
--- a/scripts/sControls.gml
+++ b/scripts/sControls.gml
@@ -0,0 +1,5 @@
+//Modernized: opens the Controls panel on the page (migrate/controls.js) from the title screen: the keys as they
+//are bound now, what a controller does, where to change them, and a test that lights each control as it is
+//pressed. The panel keeps the keys pressed in it to itself and mutes the pad, so a test cannot reach the menu
+//behind it. The keys go with it so the panel shows the player's own bindings rather than the defaults.
+controls_open(global.key_up,global.key_down,global.key_left,global.key_right,global.key_action,global.key_cancel,global.key_start);
