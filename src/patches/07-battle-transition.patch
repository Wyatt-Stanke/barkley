diff -ruN a/objects/oBattleTrans/0_0.gml b/objects/oBattleTrans/0_0.gml
--- a/objects/oBattleTrans/0_0.gml
+++ b/objects/oBattleTrans/0_0.gml
@@ -0,0 +1,10 @@
+//Plays a battle transition over the room it is created in and follows the game into troom (see sBattleTrans).
+persistent=1; //it has to live through the room change it asks for
+depth=16000; //draw events run in depth order, so Post Draw reaches the application surface before oScreenFill presents it
+cap=-1; //the grab of the room being left
+phase=0; //0 grab it, 1 wait for the new room, 2 play the effect
+t=0;
+wait=0;
+dur=20; //frames the effect lasts, two thirds of a second
+kind=0;
+troom=room;
diff -ruN a/objects/oBattleTrans/3_1.gml b/objects/oBattleTrans/3_1.gml
--- a/objects/oBattleTrans/3_1.gml
+++ b/objects/oBattleTrans/3_1.gml
@@ -0,0 +1,2 @@
+if (!variable_instance_exists(id,'phase')) { instance_destroy(); exit; } //a resume restores Create's variables after it is skipped
+if (phase=1) { wait+=1; if (wait=3) room_goto(troom); } //Post Draw asked already; ask again if the change went missing
diff -ruN a/objects/oBattleTrans/8_77.gml b/objects/oBattleTrans/8_77.gml
--- a/objects/oBattleTrans/8_77.gml
+++ b/objects/oBattleTrans/8_77.gml
@@ -0,0 +1,31 @@
+//One frame of the battle transition, drawn into the application surface so it is in game pixels and whatever
+//scaling the player picked still applies (oScreenFill presents the surface after this; see the depth in Create).
+var cw, ch;
+if (!variable_instance_exists(id,'cap')) { instance_destroy(); exit; } //a resume restores Create's variables after it is skipped
+if (!surface_exists(application_surface)) exit;
+if (phase=0) { //grab the room being left: room_goto has not run yet, so this frame still drew it
+cw=surface_get_width(application_surface);
+ch=surface_get_height(application_surface);
+cap=surface_create(cw,ch);
+surface_set_target(cap);
+draw_clear_alpha(c_black,1);
+draw_surface(application_surface,0,0);
+surface_reset_target();
+phase=1;
+room_goto(troom); //the room changes at the end of this frame, after the grab
+exit; //the screen already shows what was just grabbed
+}
+if (!surface_exists(cap)) { instance_destroy(); exit; } //nothing left to draw with
+cw=surface_get_width(cap);
+ch=surface_get_height(cap);
+surface_set_target(application_surface);
+gpu_set_texfilter(0);
+if (phase=1) { //the room has not changed yet: hold the picture
+draw_surface_ext(cap,0,0,1,1,0,c_white,1);
+if (room=troom) phase=2;
+} else {
+sBattleTransDraw(kind,t/dur,cap,cw,ch);
+t+=1;
+}
+surface_reset_target();
+if (phase=2 && (t>dur || room!=troom)) { surface_free(cap); cap=-1; instance_destroy(); } //done, or the game moved on
diff -ruN a/scripts/sBattleStart.gml b/scripts/sBattleStart.gml
--- a/scripts/sBattleStart.gml
+++ b/scripts/sBattleStart.gml
@@ -1,3 +1,5 @@
+//One transition means one battle: a roaming enemy can touch the player again before the room changes.
+if (instance_exists(oBattleTrans)) exit;
 //Transfer enemies, arg0 is batface to delete who if 0 planned encounter
 for (k=0; ene[k]!=""; k+=1) {
 global.bene[k]=ene[k];
@@ -7,4 +9,4 @@
 global.b_room=room;
 global.batface=argument0;
 sS(mBattleSound);
-rt_trans(RomInter);
\ No newline at end of file
+sBattleTrans(RomInter); //a transition effect first; it goes to RomInter once it has grabbed the screen
\ No newline at end of file
diff -ruN a/scripts/sBattleTrans.gml b/scripts/sBattleTrans.gml
--- a/scripts/sBattleTrans.gml
+++ b/scripts/sBattleTrans.gml
@@ -0,0 +1,10 @@
+//Go to room argument0 through one of sBattleTransDraw's transitions.
+//GM6 called the rt_ library here. It built its transition object with object_add/object_event_add, grabbed the
+//screen with screen_redraw and cross-faded two grabs in a loop of sleep/screen_refresh. LTS has none of those
+//functions, and a loop that holds the frame never reaches the screen on HTML5, so oBattleTrans grabs the room
+//being left and plays the effect over the new one a frame at a time.
+var o;
+if (instance_exists(oBattleTrans)) exit; //one is already on its way
+o=instance_create(0,0,oBattleTrans);
+o.troom=argument0;
+o.kind=floor(random(19)); //sBattleTransDraw has effects 0 to 18
diff -ruN a/scripts/sBattleTransDraw.gml b/scripts/sBattleTransDraw.gml
--- a/scripts/sBattleTransDraw.gml
+++ b/scripts/sBattleTransDraw.gml
@@ -0,0 +1,51 @@
+//One frame of a battle transition: argument0 picks the effect, argument1 is how far through it is (0 to 1),
+//argument2 holds a grab of the room being left and argument3/argument4 are its size.
+//The caller draws into the application surface, so this works in game pixels and the player's scaling still applies.
+//The rt_ originals cross-faded two frozen grabs; here the new room is already running underneath, so these take the
+//old screen away, and the ones that pass through black uncover the new room in their second half.
+var k, p, cap, cw, ch, a, q, b, n, s, r, d, u, i, j, ca, cb;
+k=argument0; p=argument1; cap=argument2; cw=argument3; ch=argument4;
+a=1-p; //the grab thins out as it goes
+draw_set_alpha(1);
+if (k>=6 && k<=14) { //through black: cover the old room in the first half, uncover the new one in the second
+if (p<0.5) { draw_surface_ext(cap,0,0,1,1,0,c_white,1); q=p*2; } else { q=2-p*2; }
+draw_set_color(c_black);
+b=16; //cell size for the ones that break the screen up
+if (k=6) { n=8; s=ch/n; for (i=0; i<n; i+=1) draw_rectangle(0,i*s,cw,i*s+s*q,0); } //blinds
+else if (k=7) { n=10; s=cw/n; for (i=0; i<n; i+=1) draw_rectangle(i*s,0,i*s+s*q,ch,0); }
+else if (k=8) draw_rectangle(0,0,cw*q,ch,0); //wipes
+else if (k=9) draw_rectangle(cw-cw*q,0,cw,ch,0);
+else if (k=10) draw_rectangle(0,0,cw,ch*q,0);
+else if (k=11) draw_rectangle(0,ch-ch*q,cw,ch,0);
+else if (k=12) { //cells go out in a scattered order, the same one every time so it does not flicker
+for (i=0; i<cw; i+=b) for (j=0; j<ch; j+=b) {
+ca=i/b; cb=j/b;
+u=((ca*ca*13+cb*cb*7+ca*cb*29) mod 97)/97; //a plain multiple of the cell leaves visible diagonals; the squares break them up
+if (q>u) draw_rectangle(i,j,i+b,j+b,0);
+}
+}
+else if (k=13) { s=b*q/2; for (i=0; i<cw; i+=b) for (j=0; j<ch; j+=b) draw_rectangle(i+b/2-s,j+b/2-s,i+b/2+s,j+b/2+s,0); } //cells grow from their middle
+else { for (i=0; i<cw; i+=b) for (j=0; j<ch; j+=b) draw_rectangle(i,j,i+b*q,j+b*q,0); } //cells grow from their corner
+draw_set_color(c_white);
+exit;
+}
+if (k=0) { //spin: the grab turns about the middle, as rt_spin did
+n=sqrt(sqr(cw/2)+sqr(ch/2));
+d=point_direction(cw/2,ch/2,0,0);
+r=180*p*p;
+draw_surface_ext(cap,cw/2+lengthdir_x(n,r+d),ch/2+lengthdir_y(n,r+d),1,1,r,c_white,a);
+}
+else if (k=1) { s=1+3*p*p; draw_surface_ext(cap,cw/2-cw*s/2,ch/2-ch*s/2,s,s,0,c_white,a); } //zoom
+else if (k=2) { //blur: copies pulling apart from the middle
+for (i=0; i<5; i+=1) { s=1+p*0.15*(i+1); draw_surface_ext(cap,cw/2-cw*s/2,ch/2-ch*s/2,s,s,0,c_white,a*(1-i*0.15)); }
+}
+else if (k=3) { n=8; for (i=0; i<ch; i+=n) { u=sin(i/ch*12+p*10)*p*40; draw_surface_part_ext(cap,0,i,cw,n,u,i,1,1,c_white,a); } } //wavy
+else if (k=4) { u=p*p*24; draw_surface_ext(cap,floor(random(u*2+1))-u,floor(random(u*2+1))-u,1,1,0,c_white,min(1,2-p*2)); } //quake
+else if (k=5) { b=4*(1+floor(p*7)); for (i=0; i<cw; i+=b) for (j=0; j<ch; j+=b) draw_surface_part_ext(cap,i,j,1,1,i,j,b,b,c_white,a); } //pixelate
+else { //slide the old screen off one side, as the cube and plane transitions did
+u=p*p;
+if (k=15) draw_surface_ext(cap,-cw*u,0,1,1,0,c_white,1);
+else if (k=16) draw_surface_ext(cap,cw*u,0,1,1,0,c_white,1);
+else if (k=17) draw_surface_ext(cap,0,-ch*u,1,1,0,c_white,1);
+else draw_surface_ext(cap,0,ch*u,1,1,0,c_white,1);
+}
