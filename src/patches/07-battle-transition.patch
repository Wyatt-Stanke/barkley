diff -ruN a/objects/oBattleTrans/0_0.gml b/objects/oBattleTrans/0_0.gml
--- a/objects/oBattleTrans/0_0.gml
+++ b/objects/oBattleTrans/0_0.gml
@@ -0,0 +1,14 @@
+//Plays a battle transition over the room it is created in and follows the game into troom (see sBattleTrans).
+persistent=1; //it has to live through the room change it asks for
+depth=16000; //draw events run in depth order, so Post Draw reaches the application surface before oScreenFill presents it
+cap=-1; //the grab of the room being left
+cap2=-1; //a grab of the room being entered, for the effects that need it as a texture of its own
+phase=0; //0 grab it, 1 wait for the new room, 2 play the effect
+t=0;
+wait=0;
+dur=20; //frames the effect lasts; sBattleTransInit sets the real length
+kind=0;
+np=0; //tiles the effect broke the grab into, if it is one of the particle ones
+pw=20; //the rt_ library's tile size
+pn=0; //how far a dissolve's sweep has crossed the screen
+troom=room;
diff -ruN a/objects/oBattleTrans/3_1.gml b/objects/oBattleTrans/3_1.gml
--- a/objects/oBattleTrans/3_1.gml
+++ b/objects/oBattleTrans/3_1.gml
@@ -0,0 +1,2 @@
+if (!variable_instance_exists(id,'phase')) { instance_destroy(); exit; } //a resume restores Create's variables after it is skipped
+if (phase=1) { wait+=1; if (wait=3) room_goto(troom); } //Post Draw asked already; ask again if the change went missing
diff -ruN a/objects/oBattleTrans/8_77.gml b/objects/oBattleTrans/8_77.gml
--- a/objects/oBattleTrans/8_77.gml
+++ b/objects/oBattleTrans/8_77.gml
@@ -0,0 +1,45 @@
+//One frame of the battle transition, drawn into the application surface so it is in game pixels and whatever
+//scaling the player picked still applies (oScreenFill presents the surface after this; see the depth in Create).
+var cw, ch;
+if (!variable_instance_exists(id,'cap')) { instance_destroy(); exit; } //a resume restores Create's variables after it is skipped
+if (!surface_exists(application_surface)) exit;
+if (phase=0) { //grab the room being left: room_goto has not run yet, so this frame still drew it
+cw=surface_get_width(application_surface);
+ch=surface_get_height(application_surface);
+cap=surface_create(cw,ch);
+surface_set_target(cap);
+draw_clear_alpha(c_black,1);
+draw_surface(application_surface,0,0);
+surface_reset_target();
+dur=sBattleTransInit(kind,cw,ch);
+phase=1;
+room_goto(troom); //the room changes at the end of this frame, after the grab
+exit; //the screen already shows what was just grabbed
+}
+if (!surface_exists(cap)) { instance_destroy(); exit; } //nothing left to draw with
+cw=surface_get_width(cap);
+ch=surface_get_height(cap);
+if (phase=2 && kind>=28) { //the cube and plane effects need the new room as a texture of its own, so copy it out first
+if (!surface_exists(cap2)) cap2=surface_create(cw,ch);
+surface_set_target(cap2);
+draw_clear_alpha(c_black,1);
+draw_surface(application_surface,0,0);
+surface_reset_target();
+}
+surface_set_target(application_surface);
+gpu_set_texfilter(0);
+if (phase=1) { //the room has not changed yet: hold the picture
+draw_surface_ext(cap,0,0,1,1,0,c_white,1);
+if (room=troom) phase=2;
+} else {
+sBattleTransDraw(kind,t,dur,cap,cw,ch);
+t+=1;
+}
+surface_reset_target();
+if (phase=2 && (t>dur || room!=troom)) { //done, or the game moved on
+surface_free(cap);
+cap=-1;
+if (surface_exists(cap2)) surface_free(cap2);
+cap2=-1;
+instance_destroy();
+}
