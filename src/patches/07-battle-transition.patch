diff -ruN a/scripts/sBattleTrans.gml b/scripts/sBattleTrans.gml
--- a/scripts/sBattleTrans.gml
+++ b/scripts/sBattleTrans.gml
@@ -0,0 +1,10 @@
+//Go to room argument0 through one of sBattleTransDraw's transitions.
+//GM6 called the rt_ library here. It built its transition object with object_add/object_event_add, grabbed the
+//screen with screen_redraw and cross-faded two grabs in a loop of sleep/screen_refresh. LTS has none of those
+//functions, and a loop that holds the frame never reaches the screen on HTML5, so oBattleTrans grabs the room
+//being left and plays the effect over the new one a frame at a time.
+var o;
+if (instance_exists(oBattleTrans)) exit; //one is already on its way
+o=instance_create(0,0,oBattleTrans);
+o.troom=argument0;
+o.kind=floor(random(36)); //the same 36 effects rt_init put in the pool, in its order
diff -ruN a/scripts/sBattleTransDraw.gml b/scripts/sBattleTransDraw.gml
--- a/scripts/sBattleTransDraw.gml
+++ b/scripts/sBattleTransDraw.gml
@@ -0,0 +1,62 @@
+//One frame of a battle transition: argument0 picks the effect, argument1 the frame it is on and argument2 how
+//many frames it lasts, argument3 holds a grab of the room being left and argument4/argument5 are its size.
+//It is called from oBattleTrans with the application surface as the target, so this works in game pixels and the
+//player's scaling still applies. The rt_ originals cross-faded two frozen grabs; here the new room is already
+//running underneath, so these take the old screen away over it.
+var k, t, dur, cap, cw, ch, p, a, i, j, r, s, u, d, n, b, hor, rev, sg, l, m, e0, e1, e2, co, cn;
+k=argument0; t=argument1; dur=argument2; cap=argument3; cw=argument4; ch=argument5;
+p=t/dur; //how far through, 0 to 1
+a=1-p; //the grab thins out as it goes
+draw_set_alpha(1);
+draw_set_color(c_white);
+if (k>=10 && k<=27) { sBattleTransTiles(k,cap,cw,ch); exit; } //the particle ones keep their tiles on the instance
+if (k>=28) { //cube and plane: the two screens are walls turning past the camera, over black
+hor=(k=28 || k=29 || k=32 || k=33);
+if (hor) { l=cw; m=ch; } else { l=ch; m=cw; }
+draw_clear(c_black);
+if (k<32) { //cube: the old wall slides off one edge as the new one comes in behind it
+rev=(k=29 || k=31);
+n=100; //how far the far edge of a wall leans in
+if (p<0.5) { i=p; u=l*(1-i); e0=n*i; e1=-n*i; e2=n*(1-i); co=1-i; cn=i; }
+else { i=1-p; u=l*i; e0=n*(1-i); e1=-n*i; e2=n*i; co=i; cn=1-i; }
+draw_set_color(make_color_rgb(co*255,co*255,co*255));
+sBattleTransPanel(cap,hor,rev,l,m,0,u,e0,e1);
+draw_set_color(make_color_rgb(cn*255,cn*255,cn*255));
+sBattleTransPanel(cap2,hor,rev,l,m,u,l,e1,e2);
+} else { //plane: the old screen turns away edge on, then the new one turns back
+sg=1;
+if (k=33 || k=35) sg=-1;
+if (p<0.5) { i=1-p*2; sBattleTransPanel(cap,hor,0,l,m,l/2-l/2*i,l/2+l/2*i,sg*50*(1-i),-sg*50*(1-i)); }
+else { i=p*2-1; sBattleTransPanel(cap2,hor,0,l,m,l/2-l/2*i,l/2+l/2*i,-sg*50*(1-i),sg*50*(1-i)); }
+}
+draw_set_color(c_white);
+exit;
+}
+if (k=8) { u=p*p*24; draw_surface_ext(cap,floor(random(u*2+1))-u,floor(random(u*2+1))-u,1,1,0,c_white,min(1,2-p*2)); exit; } //quake
+if (k=9) { s=1+3*p*p; draw_surface_ext(cap,cw/2-cw*s/2,ch/2-ch*s/2,s,s,0,c_white,a); exit; } //zoom
+//the first eight pull the whole screen apart; 4 to 7 are the same four again, through black
+if (k>=4 && p>=0.5) { //past halfway a fade is black lifting off the new room
+draw_set_color(c_black);
+draw_set_alpha(2-p*2);
+draw_rectangle(0,0,cw,ch,0);
+draw_set_color(c_white);
+draw_set_alpha(1);
+exit;
+}
+b=k mod 4;
+if (b=0) { //spin: the grab turns about the middle, as rt_spin did
+n=sqrt(sqr(cw/2)+sqr(ch/2));
+d=point_direction(cw/2,ch/2,0,0);
+r=180*p*p;
+draw_surface_ext(cap,cw/2+lengthdir_x(n,r+d),ch/2+lengthdir_y(n,r+d),1,1,r,c_white,a);
+}
+else if (b=1) { n=8; for (i=0; i<ch; i+=n) { u=sin(i/ch*12+p*10)*p*40; draw_surface_part_ext(cap,0,i,cw,n,u,i,1,1,c_white,a); } } //wavy
+else if (b=2) { s=4*(1+floor(p*7)); for (i=0; i<cw; i+=s) for (j=0; j<ch; j+=s) draw_surface_part_ext(cap,i,j,1,1,i,j,s,s,c_white,a); } //pixelate
+else { for (i=0; i<5; i+=1) { s=1+p*0.15*(i+1); draw_surface_ext(cap,cw/2-cw*s/2,ch/2-ch*s/2,s,s,0,c_white,a*(1-i*0.15)); } } //blur: copies pulling apart from the middle
+if (k>=4) { //the first half of a fade darkens what is left of it
+draw_set_color(c_black);
+draw_set_alpha(min(1,p*2));
+draw_rectangle(0,0,cw,ch,0);
+draw_set_color(c_white);
+draw_set_alpha(1);
+}
diff -ruN a/scripts/sBattleTransInit.gml b/scripts/sBattleTransInit.gml
--- a/scripts/sBattleTransInit.gml
+++ b/scripts/sBattleTransInit.gml
@@ -0,0 +1,41 @@
+//Sets up one of sBattleTransDraw's transitions and returns how many frames it runs for. It is called from
+//oBattleTrans's Post Draw, so the arrays it fills are that instance's. argument0 is the effect, argument1 and
+//argument2 the size of the grab it will play over.
+//Half of rt_init's pool broke the screen into 20x20 tiles and flew them off as particles, so half of these do too
+//(effects 10 to 27); each is the rt_ particle template with one or two lines changed, as the originals were.
+var k, cw, ch, i, ix, iy, lf, dr, pd;
+k=argument0; cw=argument1; ch=argument2;
+np=0;
+pw=20; //the rt_ library's tile size
+pn=0;
+dr=20;
+if (k<10) { if (k<8) dr=26; return dr; } //the ones that work on the whole screen at once
+if (k>=28) { if (k>=32) dr=24; return dr; } //cube and plane
+lf=20; //a tile's life, in frames
+if (k>=24) lf=999; //a dissolve runs until its sweep has eaten every tile, not off a lifetime
+i=0;
+for (iy=0; iy<ch; iy+=pw) for (ix=0; ix<cw; ix+=pw) {
+pd=point_direction(cw/2,ch/2,ix,iy);
+plife[i]=lf; plife0[i]=lf;
+px[i]=ix; py[i]=iy; psx[i]=ix; psy[i]=iy;
+pxs[i]=1; pys[i]=1; pa[i]=1;
+psp[i]=0; pdr[i]=0; pgr[i]=0; pgd[i]=270;
+pe1[i]=0; pe2[i]=0;
+if (k=10) pgr[i]=0.5+random(3); //crumble: every tile falls at its own rate
+else if (k=11) { psp[i]=random(10)+10; pdr[i]=pd; } //explode, thrown out from the middle
+else if (k=12) { pgr[i]=1.5; pgd[i]=pd; } //explode, pulled out from the middle
+else if (k=13) { psp[i]=random(10)+10; pdr[i]=pd+180; } //implode
+else if (k=14) { pgr[i]=1.5; pgd[i]=pd+180; }
+else if (k=15) { psp[i]=random(10)+10; pdr[i]=pd+90; } //tornado, thrown around the middle
+else if (k=16) { pgr[i]=1; pgd[i]=pd+90; }
+else if (k=17) { pgr[i]=0.5; pgd[i]=point_direction(ix,iy,cw/2,ch/2); } //drain
+else if (k=22) pe1[i]=random(0.1)+1/20; //dissolve into pixels: every tile fades at its own rate
+else if (k=23) { pe1[i]=random(1/2-1/20)+1/20; pe2[i]=1; } //random pixels: every tile waits its own time, then goes
+i+=1;
+}
+np=i;
+if (k=24) { pn=cw-pw; dr=ceil(cw/pw)+10; } //a dissolve's sweep crosses a tile a frame, then the last tiles fade
+if (k=25) { pn=0; dr=ceil(cw/pw)+10; }
+if (k=26) { pn=ch-pw; dr=ceil(ch/pw)+10; }
+if (k=27) { pn=0; dr=ceil(ch/pw)+10; }
+return dr;
diff -ruN a/scripts/sBattleTransPanel.gml b/scripts/sBattleTransPanel.gml
--- a/scripts/sBattleTransPanel.gml
+++ b/scripts/sBattleTransPanel.gml
@@ -0,0 +1,28 @@
+//Draws surface argument0 as one wall of the cube and plane transitions: a panel spanning argument5 to argument6
+//along one axis (argument1 picks x, else y; argument2 mirrors it, image and all), inset argument7 and argument8
+//on the cross axis at those two edges. argument3 is the length of the axis and argument4 of the cross axis.
+var tx, hor, rev, l, m, ua, ub, ea, eb, tt, tw, th, va, vb;
+tx=argument0; hor=argument1; rev=argument2; l=argument3; m=argument4; ua=argument5; ub=argument6; ea=argument7; eb=argument8;
+if (!surface_exists(tx)) exit;
+tt=surface_get_texture(tx);
+tw=texture_get_width(tt);
+th=texture_get_height(tt);
+va=0; vb=1;
+if (rev) { ua=l-ua; ub=l-ub; va=1; vb=0; }
+draw_primitive_begin_texture(pr_trianglelist,tt);
+if (hor) {
+draw_vertex_texture(ua,ea,va*tw,0);
+draw_vertex_texture(ub,eb,vb*tw,0);
+draw_vertex_texture(ua,m-ea,va*tw,th);
+draw_vertex_texture(ub,eb,vb*tw,0);
+draw_vertex_texture(ua,m-ea,va*tw,th);
+draw_vertex_texture(ub,m-eb,vb*tw,th);
+} else {
+draw_vertex_texture(ea,ua,0,va*th);
+draw_vertex_texture(m-ea,ua,tw,va*th);
+draw_vertex_texture(eb,ub,0,vb*th);
+draw_vertex_texture(m-ea,ua,tw,va*th);
+draw_vertex_texture(eb,ub,0,vb*th);
+draw_vertex_texture(m-eb,ub,tw,vb*th);
+}
+draw_primitive_end();
diff -ruN a/scripts/sBattleTransTiles.gml b/scripts/sBattleTransTiles.gml
--- a/scripts/sBattleTransTiles.gml
+++ b/scripts/sBattleTransTiles.gml
@@ -0,0 +1,39 @@
+//Steps and draws oBattleTrans's tiles for one frame of particle transition argument0. argument1 holds the grab
+//of the room being left and argument2/argument3 are its size.
+//This is the rt_ particle template: every tile carries a life, a speed and direction, a gravity and its own
+//scale and alpha, and each effect is that loop with one or two lines of its own at the end.
+var k, cap, cw, ch, i, r, vx, vy, cen, dx, dy;
+k=argument0; cap=argument1; cw=argument2; ch=argument3;
+cen=(k<11 || k>14); //explode and implode move a tile by its corner; the rest scale it about its middle
+for (i=0; i<np; i+=1) {
+if (plife[i]<=0) continue;
+plife[i]-=1;
+dx=px[i]; dy=py[i];
+if (cen) { dx+=pw/2*(1-pxs[i]); dy+=pw/2*(1-pys[i]); }
+draw_surface_part_ext(cap,psx[i],psy[i],pw,pw,dx,dy,pxs[i],pys[i],c_white,pa[i]);
+vx=lengthdir_x(psp[i],pdr[i])+lengthdir_x(pgr[i],pgd[i]); //the original added gravity with motion_add
+vy=lengthdir_y(psp[i],pdr[i])+lengthdir_y(pgr[i],pgd[i]);
+psp[i]=point_distance(0,0,vx,vy);
+pdr[i]=point_direction(0,0,vx,vy);
+px[i]+=vx; py[i]+=vy;
+r=plife[i]/plife0[i];
+if (k=15) pdr[i]=point_direction(cw/2,ch/2,px[i],py[i])+90; //a tornado keeps turning about the middle
+if (k=16) pgd[i]=point_direction(cw/2,ch/2,px[i],py[i])+90;
+if (k=17) pgd[i]=point_direction(px[i],py[i],cw/2,ch/2); //a drain keeps pulling to the middle
+if (k=18) pxs[i]=r; //blinds close sideways
+if (k=19) pys[i]=r; //and these the other way
+if (k=20) { pxs[i]=r; pys[i]=r; } //tiles shrink away
+if (k=21) { pxs[i]=1+(1-r)*2; pys[i]=pxs[i]; } //or grow out of the screen
+if ((k>=10 && k<=17) || k=21) pa[i]=r; //these fade a tile out over its life
+if (k=22) { pa[i]-=pe1[i]; if (pa[i]<=0) plife[i]=0; }
+if (k=23) { pe2[i]-=pe1[i]; if (pe2[i]<=0) plife[i]=0; }
+if (k=24 && pn<=px[i]) pa[i]-=0.1; //a dissolve fades every tile its sweep has passed
+if (k=25 && pn>=px[i]) pa[i]-=0.1;
+if (k=26 && pn<=py[i]) pa[i]-=0.1;
+if (k=27 && pn>=py[i]) pa[i]-=0.1;
+if (k>=24 && pa[i]<=0) plife[i]=0;
+}
+if (k=24) pn-=pw; //the sweep moves on a tile, as the original did after its own loop
+if (k=25) pn+=pw;
+if (k=26) pn-=pw;
+if (k=27) pn+=pw;
