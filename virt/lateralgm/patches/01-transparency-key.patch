+	/**
+	 * Apply a GM6/GM7 transparency key: the colour of the bottom-left pixel
+	 * becomes fully transparent everywhere it occurs.
+	 *
+	 * This exists rather than calling Util.getTransparentImage because that one
+	 * runs the pixels through java.awt's RGBImageFilter pipeline, which loses the
+	 * colour underneath the pixels it clears -- they come out transparent black.
+	 * GameMaker leaves the key colour sitting in the RGB channels, and matching it
+	 * is what makes the export pixel-for-pixel identical to GameMaker's own.
+	 */
+	private static BufferedImage keyToAlpha(BufferedImage in)
+		{
+		if (in == null) return null;
+		final int w = in.getWidth(), h = in.getHeight();
+		if (w <= 0 || h <= 0) return in;
+		final int[] argb = in.getRGB(0,0,w,h,null,0,w);
+		final int key = argb[(h - 1) * w] & 0x00FFFFFF;
+		for (int i = 0; i < argb.length; i++)
+			if ((argb[i] & 0x00FFFFFF) == key) argb[i] = key;
+		BufferedImage out = new BufferedImage(w,h,BufferedImage.TYPE_INT_ARGB);
+		out.setRGB(0,0,w,h,argb,0,w);
+		return out;
+		}
+
