+	/**
+	 * GameMaker's "smooth edges" sprite flag, baked into the alpha channel.
+	 *
+	 * GM6 stores every image as a 24-bit BMP, so the file carries no alpha at
+	 * all; the flag is a bool in the sprite record, beside preload, and GM6's own
+	 * runtime softened the silhouette when it built the texture. GMX has no field
+	 * for the flag, so GameMaker Studio 1.4 bakes the result into the exported
+	 * PNG instead. Dropping it would not be more faithful to the original game,
+	 * it would lose a setting the author made.
+	 *
+	 * The rule: a pixel that survived the transparency key gets
+	 * alpha = 255 - 32 * (how many of its eight neighbours are transparent).
+	 *
+	 * This is measured, not guessed. This game has exactly one sprite with the
+	 * flag set, sShadow, and in GameMaker's own export all 86 of its non-key
+	 * pixels match that formula exactly -- the alphas run 95/127/159/191/223,
+	 * evenly spaced by 32, none fully opaque because the shadow is thin enough
+	 * that every pixel touches its own edge. Off the image counts as transparent.
+	 */
+	private static BufferedImage smoothEdges(BufferedImage in)
+		{
+		if (in == null) return null;
+		final int w = in.getWidth(), h = in.getHeight();
+		if (w <= 0 || h <= 0) return in;
+		final int[] argb = in.getRGB(0,0,w,h,null,0,w);
+		final int[] out = new int[argb.length];
+		for (int y = 0; y < h; y++)
+			for (int x = 0; x < w; x++)
+				{
+				final int i = y * w + x;
+				if ((argb[i] >>> 24) == 0)
+					{
+					out[i] = argb[i];
+					continue;
+					}
+				int clear = 0;
+				for (int dy = -1; dy <= 1; dy++)
+					for (int dx = -1; dx <= 1; dx++)
+						{
+						if (dx == 0 && dy == 0) continue;
+						final int nx = x + dx, ny = y + dy;
+						if (nx < 0 || ny < 0 || nx >= w || ny >= h
+								|| (argb[ny * w + nx] >>> 24) == 0) clear++;
+						}
+				final int alpha = Math.max(0,255 - 32 * clear);
+				out[i] = (alpha << 24) | (argb[i] & 0x00FFFFFF);
+				}
+		BufferedImage result = new BufferedImage(w,h,BufferedImage.TYPE_INT_ARGB);
+		result.setRGB(0,0,w,h,out,0,w);
+		return result;
+		}
