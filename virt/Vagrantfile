# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# A Windows 10 VM that turns the original BarkleyV120.exe into a GameMaker:
# Studio 1.4.9999 GMX export, reproducibly and without anyone touching a mouse.
#
# Provider: QEMU (vagrant-qemu) with the host's hardware accelerator. The
# gusztavvargadr/windows-10 box is published in libvirt format, which
# vagrant-qemu consumes directly (its `box_format` is "libvirt").
#
# Everything the guest needs is fetched over HTTP from `virt/host/serve.mjs`,
# which the guest reaches at the SLIRP gateway 10.0.2.2. That same server takes
# the finished GMX back (PUT /upload/<name>), so no synced folder is needed --
# vagrant-qemu has none, and Windows would not mount a 9p share anyway.

require 'fileutils'
require 'socket'
require 'timeout'

VIRT_DIR = File.dirname(File.expand_path(__FILE__))

# Vagrant decides whether a host port is free by connecting to it with
# `Socket.tcp(host, port, connect_timeout: 0.1)`. On macOS that call hands back
# a socket even when the connection was refused -- it waits for the descriptor
# to become writable, which a refusal also does, and never re-checks the error.
# So every port looks taken, every forwarded port "collides", and `vagrant up`
# stops before it starts the VM. A plain blocking connect reports refusals
# properly; against loopback it is just as quick.
module Vagrant
  module Util
    module IsPortOpen
      def is_port_open?(host, port)
        Timeout.timeout(1) { TCPSocket.new(host, port).close }
        true
      rescue Timeout::Error, SystemCallError, SocketError
        false
      end

      extend IsPortOpen
    end
  end
end

# The QEMU binary and its data dir (firmware blobs). MacPorts first: on an Intel
# Mac running a recent macOS, Homebrew has no bottle for qemu and builds it from
# source, which takes the better part of an hour.
QEMU_PREFIXES = %w[/opt/local /usr/local /opt/homebrew].freeze
qemu_prefix = ENV['QEMU_PREFIX'] ||
              QEMU_PREFIXES.find { |p| File.executable?("#{p}/bin/qemu-system-x86_64") }
if qemu_prefix.nil?
  raise 'qemu-system-x86_64 not found. Install it with `sudo port install qemu` ' \
        '(MacPorts) or `brew install qemu`, or set QEMU_PREFIX.'
end

# The box boots UEFI (its packer template hands libvirt an OVMF pflash pair), so
# the x86_64 firmware has to be passed by hand: vagrant-qemu only wires pflash up
# for aarch64. Unit 0 is the read-only code blob; unit 1 is this machine's own
# writable copy of the variable store, which is where Windows keeps its boot
# entry.
OVMF_CODE = "#{qemu_prefix}/share/qemu/edk2-x86_64-code.fd".freeze
OVMF_VARS_TEMPLATE = "#{qemu_prefix}/share/qemu/edk2-i386-vars.fd".freeze
OVMF_VARS = File.join(VIRT_DIR, '.vagrant', 'edk2-x86_64-vars.fd').freeze

# The box ships its own Vagrantfile, whose libvirt block *raises* unless it can
# find an OVMF blob in one of two Linux paths. Vagrant evaluates that block even
# though vagrant-libvirt is not installed here, so point its escape hatch at the
# firmware we already found.
ENV['VAGRANT_LIBVIRT_OVMF_CODE'] ||= OVMF_CODE

unless File.exist?(OVMF_VARS)
  FileUtils.mkdir_p(File.dirname(OVMF_VARS))
  FileUtils.cp(OVMF_VARS_TEMPLATE, OVMF_VARS)
  FileUtils.chmod(0o644, OVMF_VARS)
end

# Host ports. The QEMU monitor is a plain TCP readline socket, which is how
# `virt/screenshot.sh` photographs the guest's framebuffer without involving
# Windows at all.
MONITOR_PORT = Integer(ENV.fetch('BARKLEY_MONITOR_PORT', 45_555))
FILES_PORT   = Integer(ENV.fetch('BARKLEY_FILES_PORT', 8899))

Vagrant.configure('2') do |config|
  config.vm.box = 'gusztavvargadr/windows-10'
  config.vm.box_version = ENV.fetch('BARKLEY_BOX_VERSION', '2511.0.0')

  config.vm.guest = :windows
  config.vm.communicator = 'winrm'
  config.winrm.username = 'vagrant'
  config.winrm.password = 'vagrant'
  # A cold Windows boot, plus the box's own first-run work, is slow; and the GMX
  # export itself runs for several minutes under WinRM.
  config.vm.boot_timeout = 3600
  config.winrm.timeout = 7200
  config.winrm.retry_limit = 200
  config.winrm.max_tries = 200

  # vagrant-qemu has no synced folders (and the guest is Windows).
  config.vm.synced_folder '.', '/vagrant', disabled: true

  # No forwarded_port declarations here: Vagrant already defines the WinRM
  # forward for a Windows guest (5985 -> 55985), and the box defines RDP
  # (3389 -> 53389). Declaring them again produces a second entry for the same
  # host port, which Vagrant then reports as a collision with itself.

  config.vm.provider 'qemu' do |qe|
    qe.arch = 'x86_64'
    qe.qemu_bin = "#{qemu_prefix}/bin/qemu-system-x86_64"
    qe.qemu_dir = "#{qemu_prefix}/share/qemu"

    # Everything about how the machine is virtualised is an environment
    # variable, because this guest corrupts its own kernel memory under load and
    # finding out what stops it means changing one of these at a time. See
    # virt/README.md, "The guest bugchecks under load", for what has been ruled
    # out so far -- and note that a change here only takes effect on a `reload`,
    # since vagrant-qemu builds the command line when the machine starts.
    #
    #   BARKLEY_VM_ACCEL=tcg   emulate instead of using the host's accelerator:
    #                          much slower, but it is not HVF, so it is the test
    #                          that says whether HVF is at fault at all
    accel = ENV.fetch('BARKLEY_VM_ACCEL', 'hvf')
    qe.machine = "q35,accel=#{accel}"

    # Penryn, and this is the one that matters. With `-cpu host` this guest
    # corrupted its own kernel memory under load: nineteen bugchecks over two
    # runs, 0xA and 0xD1 reads of wild addresses at DISPATCH_LEVEL and a 0x1E
    # carrying STATUS_ILLEGAL_INSTRUCTION -- the kernel being sent to an
    # instruction the CPU rejected. Neither masking TSX off nor dropping to one
    # vCPU made any difference. Asking HVF for a small, old, well-trodden
    # feature set instead of the host's did: the run that had been crashing
    # within two minutes got all the way through, and the machine has been up
    # since. Penryn is also what UTM picks by default for x86_64, which is
    # presumably the same lesson learned elsewhere.
    qe.cpu = ENV.fetch('BARKLEY_VM_CPU', 'Penryn')
    # One vCPU. This did not fix the bugchecks -- four more arrived inside ten
    # minutes with it -- but SMP buys little here, so it stays.
    qe.smp = ENV.fetch('BARKLEY_VM_CPUS', '1')
    qe.memory = ENV.fetch('BARKLEY_VM_MEMORY', '6G')

    # The image carries no virtio drivers (the box's own libvirt config asks for
    # a SATA disk and an e1000e NIC), so use devices Windows ships drivers for.
    # On q35 an `if=ide` drive lands on the chipset's AHCI controller.
    qe.drive_interface = 'ide'
    # e1000 (the 82540EM) is the older, duller, far more exercised of the two
    # emulations, and the one to fall back to if e1000e is ever suspected.
    qe.net_device = ENV.fetch('BARKLEY_VM_NET', 'e1000e')

    qe.control_port = MONITOR_PORT

    # The plugin's default, minus `-vga none`: the GameMaker IDE has to be driven
    # through a real desktop, so the guest needs a display adapter even though
    # nothing here ever opens a QEMU window.
    qe.other_default = %w[-parallel none -monitor none -display none]

    # NB: `#` inside a %W[] literal is not a comment, it is an array element --
    # so every note about these arguments has to live out here.
    #
    # The sound card plays into nothing, and exists only so that a sound card
    # exists: the patcher is a GameMaker 8.1 game, and on a machine without one
    # it opens a modal "No sound device detected" dialog that then sits in front
    # of its own UI forever. Windows 10 has an inbox driver for intel-hda, and
    # the `none` backend means QEMU never touches the host's audio.
    qe.extra_qemu_args = %W[
      -drive if=pflash,format=raw,unit=0,readonly=on,file=#{OVMF_CODE}
      -drive if=pflash,format=raw,unit=1,file=#{OVMF_VARS}
      -device VGA,xres=1440,yres=900
      -device qemu-xhci -device usb-tablet
      -rtc base=localtime
      -audiodev none,id=snd0
      -device intel-hda
      -device hda-duplex,audiodev=snd0
    ]
  end

  # Stage 1: everything that needs no desktop -- the file host's address, the
  # tools, and an autologon session for the GUI stage to run inside.
  config.vm.provision 'bootstrap',
                      type: 'shell',
                      path: 'provision/01-bootstrap.ps1',
                      args: ['-FilesUrl', "http://10.0.2.2:#{FILES_PORT}"]

  # Autologon and the UAC setting only take effect at the next logon, and every
  # later stage needs the desktop they produce.
  config.vm.provision 'reboot',
                      type: 'shell',
                      inline: 'Write-Host "Rebooting into the autologon desktop"',
                      reboot: true
end
